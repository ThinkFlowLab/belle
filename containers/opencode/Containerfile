ARG DEBIAN_TAG=bookworm-slim

# linux-x64 requires AVX2. Update the checksums with the version or a target.
ARG OPENCODE_VERSION=2.2.5
ARG OPENCODE_TARGET_AMD64=linux-x64
ARG OPENCODE_SHA512_AMD64=0641c07d3a8db20feaa61c8736b9c7f831a43b166c1a36a63693390efc2812fcfb6403cdc3c9846cc5c64c20ce007fbffb8d04a9e89ee8a359059650c0f0a368
ARG OPENCODE_TARGET_ARM64=linux-arm64
ARG OPENCODE_SHA512_ARM64=3b8a8ecbf5916109a10a5301ff9a816a861fcda0cad7e3c945039f53cd22c728f9aee41b0b1ada1fe556d94c876fa4563a552fe357de73e8ac77ad8bbc2bb0b8
ARG OPENCODE_LICENSE_SHA256=625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b

FROM docker.io/library/debian:${DEBIAN_TAG} AS fetch

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
ARG OPENCODE_VERSION
ARG OPENCODE_TARGET_AMD64
ARG OPENCODE_SHA512_AMD64
ARG OPENCODE_TARGET_ARM64
ARG OPENCODE_SHA512_ARM64
ARG OPENCODE_LICENSE_SHA256

# docker-clean empties the apt cache mount: set it aside, then restore it for images built FROM this one.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    mv /etc/apt/apt.conf.d/docker-clean /etc/apt/apt.conf.d/docker-clean.disabled \
    && apt update \
    && apt -o APT::Keep-Downloaded-Packages=true install -y --no-install-recommends \
        ca-certificates \
        curl \
    && mv /etc/apt/apt.conf.d/docker-clean.disabled /etc/apt/apt.conf.d/docker-clean

RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) target="$OPENCODE_TARGET_AMD64"; sum="$OPENCODE_SHA512_AMD64" ;; \
      arm64) target="$OPENCODE_TARGET_ARM64"; sum="$OPENCODE_SHA512_ARM64" ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://registry.npmjs.org/@opencode/cli-${target}/-/cli-${target}-${OPENCODE_VERSION}.tgz"; \
    curl -fsSL -o /tmp/cli.tgz "$url"; \
    echo "${sum}  /tmp/cli.tgz" | sha512sum -c -; \
    tar -xzf /tmp/cli.tgz -C /tmp package/bin/opencode; \
    install -m 0755 /tmp/package/bin/opencode /opt/opencode; \
    curl -fsSL -o /opt/LICENSE "https://raw.githubusercontent.com/anomalyco/opencode/v${OPENCODE_VERSION}/LICENSE"; \
    echo "${OPENCODE_LICENSE_SHA256}  /opt/LICENSE" | sha256sum -c -

FROM docker.io/library/debian:${DEBIAN_TAG} AS plain
ARG DEBIAN_FRONTEND=noninteractive

# OpenCode reads Git metadata from its working directory.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    mv /etc/apt/apt.conf.d/docker-clean /etc/apt/apt.conf.d/docker-clean.disabled \
    && apt update \
    && apt -o APT::Keep-Downloaded-Packages=true upgrade -y \
    && apt -o APT::Keep-Downloaded-Packages=true install -y --no-install-recommends \
        ca-certificates \
        git \
    && mv /etc/apt/apt.conf.d/docker-clean.disabled /etc/apt/apt.conf.d/docker-clean

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin opencode \
    && mkdir -p /workspace/.opencode/plugins \
    && chown -R opencode:opencode /workspace

COPY --from=fetch /opt/opencode /usr/local/bin/opencode
COPY --from=fetch /opt/LICENSE /usr/share/licenses/opencode/LICENSE
COPY LICENSE NOTICE /usr/share/licenses/belle-agent/
COPY containers/opencode/opencode.jsonc /etc/opencode/opencode.jsonc

COPY --chown=opencode:opencode src/belle_agent/skills /workspace/.opencode/skills

# Baked plugins and skills need no watcher, which can exhaust host inotify slots.
ENV HOME=/home/opencode \
    OPENCODE_CONFIG=/etc/opencode/opencode.jsonc \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_FILEWATCHER=1

USER opencode
WORKDIR /workspace
EXPOSE 4096

CMD ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]

FROM plain AS relay

ARG RELAY=src/belle_agent/integrations/opencode/plugin/relay.ts
COPY --chown=opencode:opencode ${RELAY} /workspace/.opencode/plugins/relay.ts
