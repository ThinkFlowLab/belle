FROM docker.io/library/python:3.11-slim
ARG PIP_DISABLE_PIP_VERSION_CHECK=1
ARG PIP_ROOT_USER_ACTION=ignore
WORKDIR /src
COPY pyproject.toml README.md LICENSE NOTICE /src/
COPY LICENSE NOTICE /usr/share/licenses/belle-agent/
COPY src/belle_agent /src/src/belle_agent
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install '.[tui]'
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin belle
USER belle
WORKDIR /home/belle
ENTRYPOINT ["belle-tui"]
